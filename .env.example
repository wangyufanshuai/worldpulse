# Explanatory report provider used by the legacy analysis/report layer.
# This is separate from the controlled lifecycle Agent Runtime below.
AI_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=siliconflow
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1800

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

WORLDPULSE_DB_PATH=data/worldpulse.db
WORLDPULSE_UPLOAD_ROOT=data/uploads
WORLDPULSE_MAX_UPLOAD_BYTES=26214400
WORLDPULSE_DOCUMENTS_ENABLED=1
SCENARIO_EXTRACTION_PROVIDER=disabled
SCENARIO_EXTRACTION_FALLBACK=deterministic

# Continuous intelligence is opt-in and performs outbound network access only
# from the ingestion worker. Production feeds and webhooks must use HTTPS.
WORLDPULSE_CONTINUOUS_INTELLIGENCE=0
WORLDPULSE_FEED_ALLOW_HTTP=0
WORLDPULSE_WEBHOOK_HOST_ALLOWLIST=hooks.example.org
# Subscriptions store only the reference suffix (for example: PRIMARY).
WORLDPULSE_WEBHOOK_SECRET_PRIMARY=replace_with_a_random_secret

# Controlled lifecycle Agent Runtime. It only produces structured proposals;
# it never owns deterministic risk or supply-chain values. Safe default: mock.
AGENT_PROVIDER=mock
AGENT_MODEL=mock-deterministic-v1
AGENT_MAX_TURNS=1
AGENT_MAX_AGENTS=4
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_CALLS=8
AGENT_TOKEN_BUDGET=12000
AGENT_MAX_INPUT_CHARS=16000
AGENT_MAX_OUTPUT_CHARS=6000
AGENT_FALLBACK_MODE=mock
AGENT_SEED=42
# Negotiation mode uses fixed ceilings: 12 agents, 6 ticks, 6 active/tick,
# 36 calls, 60k tokens, 30-second timeout and live-provider concurrency 2.
# Runtime and local security
WORLDPULSE_ENV=development
WORLDPULSE_AUTO_MIGRATE=1
WORLDPULSE_AUTH_MODE=disabled
WORLDPULSE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
