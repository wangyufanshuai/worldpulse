# Explanatory report provider used by the legacy analysis/report layer.
# This is separate from the controlled lifecycle Agent Runtime below.
AI_PROVIDER=deepseek
AI_FALLBACK_PROVIDER=siliconflow
AI_TIMEOUT_SECONDS=45
AI_MAX_TOKENS=1800

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.com/v1
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V3

WORLDPULSE_DB_PATH=data/worldpulse.db

# Controlled lifecycle Agent Runtime. It only produces structured proposals;
# it never owns deterministic risk or supply-chain values. Safe default: mock.
AGENT_PROVIDER=mock
AGENT_MODEL=mock-deterministic-v1
AGENT_MAX_TURNS=1
AGENT_MAX_AGENTS=4
AGENT_TIMEOUT_SECONDS=30
AGENT_MAX_CALLS=8
AGENT_TOKEN_BUDGET=12000
AGENT_MAX_INPUT_CHARS=16000
AGENT_MAX_OUTPUT_CHARS=6000
AGENT_FALLBACK_MODE=mock
AGENT_SEED=42
